CASE_HUNTER_DB=data/case_hunter.db
# Producción persistente opcional. Si queda vacío, Case Hunter usa SQLite.
# Ejemplo: postgresql://usuario:password@host:5432/casehunter
CASE_HUNTER_DATABASE_URL=
CASE_HUNTER_LEY_LOBBY_URL=https://www.leylobby.gob.cl/instituciones/AM002/cargos-pasivos/642196/audiencias
MERCADO_PUBLICO_TICKET=
CASE_HUNTER_USERNAME=
CASE_HUNTER_PASSWORD=

# Case Hunter Auto
CASE_HUNTER_AUTO_YEAR=2026
CASE_HUNTER_AUTO_SOURCE_URLS=https://www.leylobby.gob.cl/instituciones/AM010/audiencias/2026,https://www.leylobby.gob.cl/instituciones/AM007/audiencias/2026
CASE_HUNTER_AUTO_INTERVAL_MINUTES=360
CASE_HUNTER_AUTO_MIN_PRIORITY=20
CASE_HUNTER_AUTO_MAX_PAGES=10
CASE_HUNTER_AUTO_ENRICH_LIMIT=25
CASE_HUNTER_AUTO_SUBJECTS_PER_CYCLE=20
CASE_HUNTER_AUTO_INDEX_PAGES=4
CASE_HUNTER_AUTO_CASES_PER_CYCLE=8
CASE_HUNTER_AUTO_CONTACT_DISCOVERY=1
CASE_HUNTER_CONTACT_TIMEOUT=8
CASE_HUNTER_CONTACT_MAX_SITES=2

# Envío. AUTO_POLICY_SEND permite saltar aprobación humana solo si el contacto supera la puerta estricta.
CASE_HUNTER_AUTO_SEND_APPROVED=0
CASE_HUNTER_AUTO_POLICY_SEND=0
CASE_HUNTER_AUTO_SEND_MIN_PRIORITY=70
CASE_HUNTER_AUTO_MAX_FIRST_CONTACTS_PER_DAY=10

CASE_HUNTER_AUTO_MONITOR_REPLIES=1
CASE_HUNTER_AUTO_SEND_FOLLOWUPS=0
CASE_HUNTER_AUTO_FOLLOWUP_DAYS=5
# Por privacidad, no guardar cuerpo/asunto de respuestas en la base cloud.
CASE_HUNTER_STORE_REPLY_CONTENT=0

# Gmail mediante SMTP + IMAP autenticado. Usa una contraseña de aplicación, nunca tu contraseña normal.
CASE_HUNTER_SMTP_HOST=smtp.gmail.com
CASE_HUNTER_SMTP_PORT=465
CASE_HUNTER_SMTP_USERNAME=
CASE_HUNTER_SMTP_PASSWORD=
CASE_HUNTER_SMTP_FROM_NAME=Nicolás Vega
CASE_HUNTER_IMAP_HOST=imap.gmail.com
CASE_HUNTER_IMAP_PORT=993
CASE_HUNTER_IMAP_USERNAME=
CASE_HUNTER_IMAP_PASSWORD=
